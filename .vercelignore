# Ignore heavy PyTorch model checkpoints, training data, and virtual environments
/checkpoints/
/data/
*.pt
*.bin
*.onnx
*.safetensors
__pycache__/

# Ignore root Python backend source and scripts ONLY (anchored with leading /)
/src/
/notebooks/
/scratch/
/requirements.txt
/server.py
/train.py
/evaluate.py
/app.py
/prepare_*.py
/cache_features.py
/download_weights.py
/smoke_test.py
/test_full_suite.py
/share_public.py
/Dockerfile
/docker-compose.yml
/config.yaml

# Crucial: Whitelist all frontend code so Vercel NEVER excludes frontend/src
!frontend/
!frontend/**
